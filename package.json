{
  "name": "fire-vision-monitor",
  "version": "1.2.9",
  "private": true,
  "description": "火焰/烟雾视频识别监控平台：RTSP/ONVIF 接入、7×24 检测、告警抓拍与短视频、多渠道通知、多站点隔离、审计与趋势看板",
  "license": "MIT",
  "keywords": [
    "fire-detection",
    "smoke-detection",
    "video-surveillance",
    "rtsp",
    "onvif",
    "hls",
    "ffmpeg",
    "alarm"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,yellow \"vite --host 127.0.0.1\" \"node server/index.mjs --port 8787\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node server/boot.mjs --port 8787",
    "build": "tsc --noEmit && vite build",
    "test": "node --test --test-concurrency=1 \"server/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "e2e": "node scripts/e2e-smoke.mjs",
    "reset-password": "node server/reset-password.mjs",
    "nvr:probe": "node server/nvr-probe.mjs",
    "edge": "node server/edge-gateway.mjs",
    "start": "node server/boot.mjs --port 4173",
    "preview": "node server/index.mjs --port 4173",
    "build:portable": "node scripts/package/portable.mjs",
    "build:portable:zip": "node scripts/package/portable.mjs --archive",
    "package:win": "node scripts/package/installer.mjs --target win",
    "package:linux": "node scripts/package/installer.mjs --target linux",
    "package:macos": "node scripts/package/installer.mjs --target macos",
    "verify:artifacts": "node scripts/package/verify-artifacts.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^10.0.6",
    "hls.js": "^1.7.4",
    "puppeteer-core": "25.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
